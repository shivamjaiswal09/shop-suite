{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Workspace packages use explicit .ts specifiers so Node can resolve them too.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
